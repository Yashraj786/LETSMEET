# LetsMeet Environment Configuration
# Copy this file to .env and fill in the values

# Database
DATABASE_URL=postgres://letsmeet:password@localhost/letsmeet_development

# Redis (required for Sidekiq background job processing)
REDIS_URL=redis://localhost:6379/1

# Sidekiq
SIDEKIQ_CONCURRENCY=5

# Mailer
MAILER_FROM=noreply@letsmeet.app

# Admin seed credentials (used by db:seed)
ADMIN_EMAIL=admin@letsmeet.app
ADMIN_PASSWORD=changeme_on_first_login

# Rails
RAILS_MAX_THREADS=5
