<% content_for :title, "Accept Invitation — LetsMeet" %>

<div class="auth-container">
  <div class="auth-logo">
    <span>LETSMEET</span>
  </div>

  <div class="auth-card">
    <div class="auth-title">Create Your Account</div>

    <% if @invitation %>
      <div style="background: rgba(201, 168, 76, 0.08); border: 1px solid var(--lm-border); border-radius: 8px; padding: 16px; margin-bottom: 24px;">
        <p style="font-size: 13px; color: var(--lm-muted);">
          You've been invited by <strong style="color: var(--lm-gold);"><%= @invitation.sender.display_name %></strong>.
          This invitation is reserved for <strong style="color: var(--lm-light);"><%= @invitation.recipient_email %></strong>.
        </p>
      </div>
    <% else %>
      <div class="flash flash--alert" style="margin-bottom: 24px;">
        An invitation token is required to register. If you have an invitation link, please use it directly.
      </div>
    <% end %>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <%# Pass the invitation token through the registration form %>
      <%= hidden_field_tag :invitation_token, params[:invitation_token] %>

      <div class="form-group">
        <%= f.label :email, "Email Address", class: "form-label" %>
        <%= f.email_field :email,
              autofocus: true,
              autocomplete: "email",
              class: "form-control",
              value: @invitation&.recipient_email,
              readonly: @invitation.present? %>
      </div>

      <div class="form-group">
        <%= f.label :password, "Password", class: "form-label" %>
        <% if @minimum_password_length %>
          <span class="text-muted" style="font-size: 12px; margin-left: 6px;"><%= @minimum_password_length %> characters minimum</span>
        <% end %>
        <%= f.password_field :password, autocomplete: "new-password", class: "form-control" %>
      </div>

      <div class="form-group">
        <%= f.label :password_confirmation, "Confirm Password", class: "form-label" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control" %>
      </div>

      <div style="margin-top: 24px;">
        <%= f.submit "Claim Membership", class: "btn btn-primary", style: "width: 100%; justify-content: center;", disabled: @invitation.nil? %>
      </div>
    <% end %>

    <hr class="divider">
    <%= render "devise/shared/links" %>
  </div>
</div>
