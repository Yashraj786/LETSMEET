<% content_for :title, "Sign In — LetsMeet" %>

<div class="auth-container">
  <div class="auth-logo">
    <span>LETSMEET</span>
  </div>

  <div class="auth-card">
    <div class="auth-title">Member Sign In</div>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="form-group">
        <%= f.label :email, "Email Address", class: "form-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control" %>
      </div>

      <div class="form-group">
        <%= f.label :password, "Password", class: "form-label" %>
        <%= f.password_field :password, autocomplete: "current-password", class: "form-control" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="form-group" style="display: flex; align-items: center; gap: 8px;">
          <%= f.check_box :remember_me, style: "accent-color: var(--lm-gold);" %>
          <%= f.label :remember_me, "Remember me", class: "form-label", style: "margin: 0; text-transform: none; letter-spacing: 0;" %>
        </div>
      <% end %>

      <div style="margin-top: 24px;">
        <%= f.submit "Sign In", class: "btn btn-primary w-full", style: "width: 100%; justify-content: center;" %>
      </div>
    <% end %>

    <hr class="divider">
    <%= render "devise/shared/links" %>
  </div>
</div>
