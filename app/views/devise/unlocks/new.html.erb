<% content_for :title, "Unlock Account — LetsMeet" %>

<div class="auth-container">
  <div class="auth-logo">
    <span>LETSMEET</span>
  </div>

  <div class="auth-card">
    <div class="auth-title">Unlock Your Account</div>
    <p class="text-muted" style="font-size: 14px; margin-bottom: 24px; line-height: 1.6;">
      Your account was locked after too many failed sign-in attempts. Enter your email to receive unlock instructions.
    </p>

    <%= form_for(resource, as: resource_name, url: unlock_path(resource_name), html: { method: :post }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="form-group">
        <%= f.label :email, "Email Address", class: "form-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control" %>
      </div>

      <div style="margin-top: 24px;">
        <%= f.submit "Send Unlock Instructions", class: "btn btn-primary", style: "width: 100%; justify-content: center;" %>
      </div>
    <% end %>

    <hr class="divider">
    <%= render "devise/shared/links" %>
  </div>
</div>
