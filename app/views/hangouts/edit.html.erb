<% content_for :title, "Edit #{@hangout.title} — LetsMeet" %>

<div style="max-width: 720px; margin: 0 auto;">
  <div class="page-header">
    <h1>Edit Hangout</h1>
  </div>

  <div class="card">
    <%= form_with model: @hangout, url: hangout_path(@hangout), method: :patch do |f| %>
      <% if @hangout.errors.any? %>
        <div class="flash flash--error" style="margin-bottom: 24px;">
          <strong><%= pluralize(@hangout.errors.count, "error") %>:</strong>
          <ul style="margin-top: 8px; padding-left: 20px;">
            <% @hangout.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="form-group">
        <%= f.label :title, "Title", class: "form-label" %>
        <%= f.text_field :title, class: "form-control" %>
      </div>

      <div class="form-group">
        <%= f.label :description, "Description", class: "form-label" %>
        <%= f.text_area :description, class: "form-control", rows: 5 %>
      </div>

      <div class="grid-2" style="gap: 16px;">
        <div class="form-group">
          <%= f.label :hangout_type, "Type", class: "form-label" %>
          <%= f.select :hangout_type, Hangout.hangout_types.keys.map { |t| [t.humanize, t] }, {}, class: "form-control" %>
        </div>
        <div class="form-group">
          <%= f.label :status, "Status", class: "form-label" %>
          <%= f.select :status, Hangout.statuses.keys.map { |s| [s.humanize, s] }, {}, class: "form-control" %>
        </div>
      </div>

      <div class="grid-2" style="gap: 16px;">
        <div class="form-group">
          <%= f.label :starts_at, "Starts At", class: "form-label" %>
          <%= f.datetime_local_field :starts_at, class: "form-control" %>
        </div>
        <div class="form-group">
          <%= f.label :ends_at, "Ends At", class: "form-label" %>
          <%= f.datetime_local_field :ends_at, class: "form-control" %>
        </div>
      </div>

      <div class="form-group">
        <%= f.label :location, "Location", class: "form-label" %>
        <%= f.text_field :location, class: "form-control" %>
      </div>

      <div class="form-group">
        <%= f.label :meeting_url, "Online Meeting URL", class: "form-label" %>
        <%= f.url_field :meeting_url, class: "form-control" %>
      </div>

      <div class="grid-2" style="gap: 16px;">
        <div class="form-group">
          <%= f.label :max_attendees, "Max Attendees", class: "form-label" %>
          <%= f.number_field :max_attendees, class: "form-control", min: 1 %>
        </div>
        <div class="form-group" style="display: flex; align-items: flex-end; padding-bottom: 12px;">
          <label class="form-label" style="display: flex; align-items: center; gap: 8px; margin: 0;">
            <%= f.check_box :invite_only %>
            Invite Only
          </label>
        </div>
      </div>

      <div class="form-group">
        <%= f.label :cover_image, "Cover Image", class: "form-label" %>
        <% if @hangout.cover_image.attached? %>
          <div style="margin-bottom: 12px;">
            <%= image_tag @hangout.cover_image.variant(resize_to_fill: [400, 200]), style: "border-radius: 8px; width: 100%; max-width: 400px;" %>
          </div>
        <% end %>
        <%= f.file_field :cover_image, class: "form-control", accept: "image/jpeg,image/png,image/webp" %>
      </div>

      <div class="flex gap-4" style="margin-top: 32px;">
        <%= f.submit "Save Changes", class: "btn btn-primary" %>
        <%= link_to "Cancel", hangout_path(@hangout), class: "btn btn-outline" %>
      </div>
    <% end %>
  </div>
</div>
