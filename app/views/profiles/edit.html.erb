<% content_for :title, "Edit Profile — LetsMeet" %>

<div style="max-width: 720px; margin: 0 auto;">
  <div class="page-header">
    <h1>Edit Profile</h1>
    <p>Control how the network sees you</p>
  </div>

  <div class="card">
    <%= form_with model: @profile, url: profile_path(@profile), method: :patch do |f| %>
      <% if @profile.errors.any? %>
        <div class="flash flash--error" style="margin-bottom: 24px;">
          <strong><%= pluralize(@profile.errors.count, "error") %>:</strong>
          <ul style="margin-top: 8px; padding-left: 20px;">
            <% @profile.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="form-group">
        <%= f.label :display_name, "Display Name", class: "form-label" %>
        <%= f.text_field :display_name, class: "form-control", placeholder: "How you appear in the network" %>
      </div>

      <div class="form-group">
        <%= f.label :bio, "Bio", class: "form-label" %>
        <%= f.text_area :bio, class: "form-control", rows: 4, placeholder: "Tell the network about yourself (500 chars max)" %>
      </div>

      <div class="grid-2" style="gap: 16px;">
        <div class="form-group">
          <%= f.label :location, "Location", class: "form-label" %>
          <%= f.text_field :location, class: "form-control", placeholder: "City, Country" %>
        </div>
        <div class="form-group">
          <%= f.label :website, "Website", class: "form-label" %>
          <%= f.url_field :website, class: "form-control", placeholder: "https://..." %>
        </div>
      </div>

      <div class="form-group">
        <%= f.label :interests, "Interests (comma-separated)", class: "form-label" %>
        <input type="text"
               name="profile[interests][]"
               class="form-control"
               placeholder="e.g. design, tech, finance, travel"
               value="<%= @profile.interests&.join(", ") %>">
        <p class="text-muted" style="font-size: 13px; margin-top: 4px;">Separate each interest with a comma</p>
      </div>

      <div class="form-group">
        <%= f.label :avatar, "Avatar", class: "form-label" %>
        <% if @profile.avatar.attached? %>
          <div style="margin-bottom: 12px; display: flex; align-items: center; gap: 12px;">
            <%= image_tag @profile.avatar.variant(resize_to_fill: [64, 64]), class: "avatar avatar-md" %>
            <span class="text-muted" style="font-size: 13px;">Current avatar</span>
          </div>
        <% end %>
        <%= f.file_field :avatar, class: "form-control", accept: "image/jpeg,image/png,image/webp" %>
        <p class="text-muted" style="font-size: 13px; margin-top: 4px;">JPEG, PNG or WebP — max 10 MB</p>
      </div>

      <div class="form-group">
        <%= f.label :cover_photo, "Cover Photo", class: "form-label" %>
        <% if @profile.cover_photo.attached? %>
          <div style="margin-bottom: 12px;">
            <%= image_tag @profile.cover_photo.variant(resize_to_fill: [600, 150]), style: "width: 100%; border-radius: 8px;" %>
          </div>
        <% end %>
        <%= f.file_field :cover_photo, class: "form-control", accept: "image/jpeg,image/png,image/webp" %>
        <p class="text-muted" style="font-size: 13px; margin-top: 4px;">JPEG, PNG or WebP — max 25 MB</p>
      </div>

      <div class="form-group" style="display: flex; align-items: center; gap: 12px;">
        <%= f.check_box :public_profile, style: "width: 18px; height: 18px; accent-color: var(--lm-gold);" %>
        <%= f.label :public_profile, "Make my profile visible to all members", class: "form-label", style: "margin: 0;" %>
      </div>

      <div class="flex gap-4" style="margin-top: 32px;">
        <%= f.submit "Save Profile", class: "btn btn-primary" %>
        <%= link_to "Cancel", profile_path(@profile), class: "btn btn-outline" %>
      </div>
    <% end %>
  </div>
</div>
