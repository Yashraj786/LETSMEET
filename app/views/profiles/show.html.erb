<% content_for :title, "#{@profile.display_name} — LetsMeet" %>

<div class="flex items-center gap-4" style="margin-bottom: 32px; flex-wrap: wrap;">
  <% if @profile.avatar.attached? %>
    <%= image_tag @profile.avatar.variant(resize_to_fill: [96, 96]), class: "avatar avatar-lg" %>
  <% else %>
    <div class="avatar avatar-lg avatar-placeholder" style="width: 96px; height: 96px; font-size: 32px;">
      <%= @profile.display_name[0].upcase %>
    </div>
  <% end %>

  <div style="flex: 1;">
    <h1 style="font-size: 28px; font-weight: 800; color: var(--lm-light);"><%= @profile.display_name %></h1>
    <% if @profile.location.present? %>
      <p class="text-muted" style="margin-top: 4px;">📍 <%= @profile.location %></p>
    <% end %>
    <% if @profile.website.present? %>
      <p style="margin-top: 4px;"><%= link_to @profile.website, @profile.website, target: "_blank", style: "font-size: 14px;" %></p>
    <% end %>
  </div>

  <% if policy(@profile).edit? %>
    <%= link_to "Edit Profile", edit_profile_path(@profile), class: "btn btn-outline btn-sm" %>
  <% end %>
</div>

<% if @profile.cover_photo.attached? %>
  <%= image_tag @profile.cover_photo.variant(resize_to_fill: [1200, 300]), style: "width: 100%; height: 220px; object-fit: cover; border-radius: var(--lm-radius); margin-bottom: 32px;" %>
<% end %>

<div class="grid-2">
  <div class="card">
    <div class="card-title">About</div>
    <% if @profile.bio.present? %>
      <p style="line-height: 1.8;"><%= simple_format(@profile.bio) %></p>
    <% else %>
      <p class="text-muted">No bio yet.</p>
    <% end %>

    <% if @profile.interests.present? && @profile.interests.any? %>
      <div style="margin-top: 20px;">
        <div class="card-title" style="font-size: 14px; margin-bottom: 10px;">Interests</div>
        <div style="display: flex; flex-wrap: wrap; gap: 8px;">
          <% @profile.interests.each do |interest| %>
            <span class="badge badge-gold"><%= interest %></span>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="card">
    <div class="card-title">Member Since</div>
    <p><%= @profile.user.created_at.strftime("%B %Y") %></p>

    <div class="card-title" style="margin-top: 20px;">Network Stats</div>
    <table class="table">
      <tr><th>Hangouts Attended</th><td><%= @profile.user.hangout_participants.accepted.count %></td></tr>
      <tr><th>Hangouts Hosted</th><td><%= @profile.user.created_hangouts.published.count %></td></tr>
      <tr><th>Members Invited</th><td><%= @profile.user.sent_invitations.accepted.count %></td></tr>
    </table>
  </div>
</div>
